stateDiagram-v2
  state "idle" as n0
  state "loading" as n1
  state "success" as n2
  state n2 {
    state "fresh" as n3
    state "stale" as n4
  }
  state "failure" as n5
  [*] --> n0
  n0 --> n1 : FETCH
  n1 --> n0 : CANCEL
  n1 --> n2 : done
  n1 --> n5 : error
  n3 --> n4 : after 60000
  n4 --> n1 : REFRESH
  n5 --> n1 : RETRY [canRetry]
  n5 --> n0 : RETRY
