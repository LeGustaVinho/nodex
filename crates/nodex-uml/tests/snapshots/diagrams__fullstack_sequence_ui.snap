  n0->>+n1: onCancel()
  critical try
    n1->>+n2: await cancelOrder(id)
    n2->>+n3: POST /api/Orders/{id}/cancel
    critical try
      Note right of n4: via IOrderService (dependency injection)
      n3->>+n4: await CancelOrderAsync(id, "requested by customer")
      n4->>n5: FindAsync(id) · Orders
      opt order == null
