== Syntax.Expressions.Expressions.Patterns(object, int[], Person)
Entry — when Patterns(o, values, p) is called
Var — a = o is string { Length: > 3 } s ? s : "short"
Var — b = o is not null and not int
Var — c = values is [1, .., var last] ? last : -1
Var — d = match p (5 cases)
Var — e = match o (4 cases)
Return — return a + b + c + d + e
== Syntax.Expressions.Expressions.Operators(int[], string?, Person?)
Entry — when Operators(arr, text, p) is called
Var — last = arr[^1]
Var — slice = arr[1..^1]
Var — all = arr[..]
Var — len = text?.Length ?? 0
Var — first = p?.Home?.City
Var — element = arr?[0]
Var — forced = text!.Trim()
Assign — if text is null, set it to "default"
Var — shifted = len << 2 >> 1 >>> 1
Var — cond = len > 3 ? "long" : "short"
Var — cast = (long)len
Var — safe = p as object
Var — size = sizeof(int)
Var — type = typeof(List<>)
Var — def = default(DateTime)
Var — name = nameof(Operators)
Var — check = checked(len + 1)
Var — idx = Index.FromEnd(1)
Return — return (last, slice, all, first, element, forced, shifted, cond, cast, safe, size, type, def, n…
