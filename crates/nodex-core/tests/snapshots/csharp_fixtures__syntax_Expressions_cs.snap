== Syntax.Expressions.Expressions.Strings(string, int)
Entry — when Strings(name, count) is called
Var — interp = $"Hello {name}, you have {count,5:N0} items"
Var — verbatim = @"C:\path\to"
Var — raw = """ {"name": "raw"} """
Var — rawInterp = $$"""{"name": "{{name}}"}"""
Var — utf8 = "bytes"u8.ToArray()
Var — ch = 'x'
Var — escaped = "tab\there"
Return — return interp + verbatim + raw + rawInterp + utf8.Length + ch + escaped
== Syntax.Expressions.Expressions.Linq(IEnumerable<Person>, IEnumerable<Address>)
Entry — when Linq(people, addresses) is called
Var — query = from person in people let city = person.Home?.City ?? "?" join address in addresses on …
Var — method = people → Where(x => x.Age > 1) → Select(x => x.Name) → OrderBy(n => n) → ToList()
Return — return query.Concat(method)
== Syntax.Expressions.Expressions.Lambdas()
Entry — when Lambdas() is called
Var — square = x => x * x
Var — add = (a, b) => a + b
Var — parse = static (string s) => int.Parse(s)
Var — typed = int (string s) => s.Length
Var — withDefault = (int x = 2) => x + 1
Var — asyncLambda = async x => { await Task.Delay(x); return x; }
Var — block = () => { Console.WriteLine("block"); }
Var — anonymous = delegate (int v) { Console.WriteLine(v); }
Call — block()
Call — anonymous(square(add(1, 2)))
