== Syntax.Statements.Statements.Branching(int)
Entry — when Branching(x) is called
Branch — if x < 0
  true:
    Return — return -1
  false:
    Branch — if x == 0
      true:
        Return — return 0
      false:
        Assign — decrease x by 1
Match — match x
  case:
  case:
    Assign — add 10 to x
  case:
    Jump — jump to case 1
  case:
    Return — return n
  case:
    Jump — jump to default_label
Return — return x
== Syntax.Statements.Statements.Loops(int[], Dictionary<string, int>)
Entry — when Loops(items, map) is called
Var — total = 0
Loop.Range — repeat: start int i = 0, j = items.Length - 1; while i < j; step i++
  body:
    Assign — add items[i] * items[j] to total
Loop.Infinite — repeat forever
  body:
    Branch — if total > 10
      true:
        Break — leave the loop
      false:
    Assign — increase total by 1
Loop.ForEach — for each (key, value) in map
  body:
    Assign — add key.Length + value to total
Loop.ForEach — for each item in items
  body:
    Assign — add item to total
Loop.While — while total > 100
  body:
    Assign — divide total by 2
Loop.While — repeat, then check total > 50
  body:
    Assign — decrease total by 1
    Branch — if total % 3 == 0
      true:
        Continue — skip to the next iteration
      false:
Return — return total
