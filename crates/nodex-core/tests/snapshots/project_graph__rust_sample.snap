osen from the machine running Nodex. It is unsigned, so it cannot be negative; for N bits its range is 0 through 2^N - 1. usize is used for indexes and collection lengths; isize is useful for signed pointer-sized differences.","span":{"file":"src/services/order_service.rs","start_byte":3259,"end_byte":3264,"start_line":108,"start_col":36,"end_line":108,"end_col":41}},{"group":"Receives","text":"Borrow the receiver for reading","span":{"file":"src/services/order_service.rs","start_byte":3249,"end_byte":3254,"start_line":108,"start_col":26,"end_line":108,"end_col":31},"type_info":{"shape":{"kind":"Indirect","pointer":false,"target":{"kind":"Named","name":"self","arguments":[]}},"origin":"Declared","native":"&self"}},{"group":"Returns","text":"Value returned to the caller","span":{"file":"src/services/order_service.rs","start_byte":3259,"end_byte":3264,"start_line":108,"start_col":36,"end_line":108,"end_col":41},"type_info":{"shape":{"kind":"Scalar","name":"UIntSize"},"origin":"Declared","native":"usize"}},{"group":"Requires","text":"R must meet OrderRepository","span":{"file":"src/services/order_service.rs","start_byte":774,"end_byte":792,"start_line":31,"start_col":6,"end_line":31,"end_col":24}}]}
