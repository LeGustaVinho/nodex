renders the text as Markdown and can test eligible Rust code examples as documentation tests. Multiple doc-comment lines can contribute to the same item. //! instead documents the enclosing item; //// is an ordinary line comment.","span":{"file":"src/domain/order.rs","start_byte":598,"end_byte":601,"start_line":29,"start_col":1,"end_line":29,"end_col":4}},{"group":"Trait","text":"trait declares Priced as a set of behavior that types can implement. It describes what an implementing type provides; declaring the trait does not create a value. The method customer has no body here, so each implementation must provide it. Its &self parameter borrows the value being used for shared access; it does not take ownership. The method amount has no body here, so each implementation must provide it. Its &self parameter borrows the value being used for shared access; it does not take ownership. The method is_large has a default body here, which an implementation may override. Its &self parameter borrows the value being used for shared access; it does not take ownership.","span":{"file":"src/domain/order.rs","start_byte":640,"end_byte":797,"start_line":30,"start_col":1,"end_line":37,"end_col":2}}]}
{"value_info":{"kind":"Value","basis":"Syntax"},"type_info":{"shape":{"kind":"Scalar","name":"Int64"},"origin":"Declared","native":"i64"},"id":"crate::domain::order::Priced::amount","kind":"Method","name":"amount","qualified_name":"crate::domain::order::Priced::amount","parent":"crate::domain::order::Priced","language":"rust","origins":[{"file":"src/domain/order.rs","start_byte":697,"end_byte":721,"start_line":32,"start_col":5,"end_line":32,"end_col":29}],"flavors":["required","&self"],"signature":"fn amount(&self) -> i64","type_text":"i64","rust_contract":[{"group":"Receiver","text":"self names the value on which this method is called, like this in C#. &self borrows that value for shared access while the borrow lasts.","span":{"file":"src/domain/order.rs","start_byte":707,"end_byte":712,"start_line":32,"start_col":15,"end_line":32,"end_col":20}},{"group":"Shared receiver","text":"&self means this method receives a shared reference to the value it was called on. The caller keeps ownership; the method borrows that value for access rather than taking it by value. Ordinary fields cannot be changed through this shared reference, although types with interior mutability can permit controlled changes. The reference remains valid only for its borrow's lifetime; multiple shared references can coexist while Rust's borrowing rules are satisfied.","span":{"file":"src/domain/order.rs","start_byte":707,"end_byte":712,"start_line":32,"start_col":15,"end_line":32,"end_col":20}},{"group":"Signed integer type","text":"i64 is a signed 64-bit integer type. It represents whole numbers from -9,223,372,036,854,775,808 through 9,223,372,036,854,775,807, inclusive; it can hold negative values, zero, and positive values. The number after i is the number of bits, not a decimal digit count.","span":{"file":"src/domain/order.rs","start_byte":717,"end_byte":720,"start_line":32,"start_col":25,"end_line":32,"end_col":28}},{"group":"Receives","text":"Borrow the receiver for reading","span":{"file":"src/domain/order.rs","start_byte":707,"end_byte":712,"start_line":32,"start_col":15,"end_line":32,"end_col":20},"type_info":{"shape":{"kind":"Indirect","pointer":false,"target":{"kind":"Named","name":"self","arguments":[]}},"origin":"Declared","native":"&self"}},{"group":"Returns","text":"Value returned to the caller","span":{"file":"src/domain/order.rs","start_byte":717,"end_byte":720,"start_line":32,"start_col":25,"end_line":32,"end_col":28},"type_info":{"shape":{"kind":"Scalar","name":"Int64"},"origin":"Declared","native":"i64"}}]}
{"value_info":{"kind":"Reference","basis":"Syntax","qualifier":"SharedBorrow"},"type_info":{"shape":{"kind":"Indirect","pointer":false,"target":{"kind":"Scalar","name":"String"}},"origin":"Declared","native":"&str"},"id":"crate::domain::order::Priced::customer","kind":"Method","name":"customer","qualified_name":"crate::domain::order::Priced::customer","parent":"crate::domain::order::Priced","language":"rust","origins":[{"file":"src/domain/order.rs","start_byte":664,"end_byte":691,"start_line":31,"start_col":5,"end_line":31,"end_col":32}],"flavors":["required","&self"],"signature":"fn customer(&self) -> &str","type_text":"&str","rust_contract":[{"group":"Receiver","text":"self names the value on which this method is called, like this in C#. &self borrows that value for shared access while the borrow lasts.","span":{"file":"src/domain/order.rs","start_byte":676,"end_byte":681,"start_line":31,"start_col":17,"end_line":31,"end_col":22}},{"group":"Shared receiver","text":"&self means this method receives a shared reference to the value it was called on. The caller keeps ownership; the method borrows that value for access rather than taking it by value. Ordinary fields cannot be changed through this shared reference, although types with interior mutability can permit controlled changes. The reference remains valid only for its borrow's lifetime; multiple shared references can coexist while Rust's borrowing rules are satisfied.","span":{"file":"src/domain/order.rs","start_byte":676,"end_byte":681,"start_line":31,"start_col":17,"end_line":31,"end_col":22}},{"group":"String slice type","text":"Rust's built-in str is a dynamically sized sequence of bytes that must contain valid UTF-8 text. It has no fixed size known at compile time, so it is usually used behind a reference such as &str; that reference describes a borrowed portion of text and carries its length. str is not the same as String, which owns a growable buffer. The meaning of an unqualified name depends on name resolution if a name shadows the built-in type.","span":{"file":"src/domain/order.rs","start_byte":687,"end_byte":690,"start_line":31,"start_col":28,"end_line":31,"end_col":31}},{"group":"Shared reference type","text":"&str is a shared reference: it borrows a value of type str instead of taking ownership. Several shared references can coexist. The reference must remain valid for its lifetime; while it is used, ordinary mutation of the borrowed data is restricted, though types with interior mutability can permit controlled changes. A reference does not by itself copy the underlying value.","span":{"file":"src/domain/order.rs","start_byte":686,"end_byte":690,"start_line":31,"start_col":27,"end_line":31,"end_col":31}},{"group":"Borrowed string slice","text":"&str is a shared reference to a string slice: it lets code read UTF-8 text stored elsewhere without taking ownership of that text. The reference must not outlive the text it refers to. It points to a sequence of bytes, so byte positions need not correspond to characters and a slice must end at UTF-8 character boundaries. This is a borrowed view, rather than an owned, growable String.","span":{"file":"src/domain/order.rs","start_byte":686,"end_byte":690,"start_line":31,"start_col":27,"end_line":31,"end_col":31}},{"group":"Receives","text":"Borrow the receiver for reading","span":{"file":"src/domain/order.rs","start_byte":676,"end_byte":681,"start_line":31,"start_col":17,"end_line":31,"end_col":22},"type_info":{"shape":{"kind":"Indirect","pointer":false,"target":{"kind":"Named","name":"self","arguments":[]}},"origin":"Declared","native":"&self"}},{"group":"Returns","text":"A reference to data that must remain available for the required lifetime","span":{"file":"src/domain/order.rs","start_byte":686,"end_byte":690,"start_line":31,"start_col":27,"end_line":31,"end_col":31},"type_info":{"shape":{"kind":"Indirect","pointer":false,"target":{"kind":"Scalar","name":"String"}},"origin":"Declared","native":"&str"}},{"group":"Lifetime","text":"The returned reference uses the same lifetime as the reference in &self.","span":{"file":"src/domain/order.rs","start_byte":686,"end_byte":690,"start_line":31,"start_col":27,"end_line":31,"end_col":31}}]}
{"value_info":{"kind":"Value","basis":"Syntax"},"type_info":{"shape":{"kind":"Scalar","name":"Bool"},"origin":"Declared","native":"bool"},"id":"crate::domain::order::Priced::is_large","kind":"Method","name":"is_large","qualified_name":"crate::domain::order::Priced::is_large","parent":"crate::domain::order::Priced","language":"rust","origins":[{"file":"src/domain/order.rs","start_byte":729,"end_byte":794,"start_line":34,"start_col":5,"end_line":36,"end_col":6}],"flavors":["default","&self"],"signature":"fn is_large(&self) -> bool","type_text":"bool","has_flow":true,"rust_contract":[{"group":"Function","text":"fn declares a function named is_large. The parentheses contain its parameters, and the braces contain its body. Declaring it makes the function available. The body runs when the function is called.","span":{"file":"src/domain/order.rs","start_byte":729,"end_byte":731,"start_line":34,"start_col":5,"end_line":34,"end_col":7}},{"group":"Receiver","text":"self names the value on which this method is called, like this in C#. &self borrows that value for shared access while the borrow lasts.","span":{"file":"src/domain/order.rs","start_byte":741,"end_byte":746,"start_line":34,"start_col":17,"end_line":34,"end_col":22}},{"group":"Shared receiver","text":"&self means this method receives a shared reference to the value it was called on. The caller keeps ownership; the method borrows that value for access rather than taking it by value. Ordinary fields cannot be changed through this shared reference, although types with interior mutability can permit controlled changes. The reference remains valid only for its borrow's lifetime; multiple shared references can coexist while Rust's borrowing rules are satisfied.","span":{"file":"src/domain/order.rs","start_byte":741,"end_byte":746,"start_line":34,"start_col":17,"end_line":34,"end_col":22}},{"group":"Default trait method","text":"The body in braces supplies a default implementation of is_large for trait Priced. A type implementing the trait may use this body without defining the method again, or provide its own implementation to override it. The body runs when the method is called, not when the trait is declared.","span":{"file":"src/domain/order.rs","start_byte":756,"end_byte":794,"start_line":34,"start_col":32,"end_line":36,"end_col":6}},{"group":"Receives","text":"Borrow the receiver for reading","span":{"file":"src/domain/order.rs","start_byte":741,"end_byte":746,"start_line":34,"start_col":17,"end_line":34,"end_col":22},"type_info":{"shape":{"kind":"Indirect","pointer":false,"target":{"kind":"Named","name":"self","arguments":[]}},"origin":"Declared","native":"&self"}},{"group":"Returns","text":"Value returned to the caller","span":{"file":"src/domain/order.rs","start_byte":751,"end_byte":755,"start_line":34,"start_col":27,"end_line":34,"end_col":31},"type_info":{"shape":{"kind":"Scalar","name":"Bool"},"origin":"Declared","native":"bool"}}]}
