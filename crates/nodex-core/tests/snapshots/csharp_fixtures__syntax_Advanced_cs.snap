== Syntax.Advanced.Advanced.Statements(Node?, int[], Span<int>, (int, int))
Entry — when Statements(node, values, span, pair) is called
Call — node?.Items.Add(1)
Call — node?.Next?.Items.Clear()
SetMember — if node exists, set node?.Value to 5
Assign — values[0] |= 0b1010
Assign — values[1] <<= 2
Assign — values[2] >>>= 1
Var — big = 1_000_000L + 0x1F + 10UL.GetHashCode() + (int)1e3
Call — global::System.Console.WriteLine(big)
Match — match pair
  case:
    Return — return 0
  case:
    Jump — jump to the default case
  case:
Loop.ForEach — for each cell in span
  body:
    Assign — increase cell by 1
Try — try; handle errors below
  try:
    Assign — set values[0] to 1
  finally:
    Assign — set values[1] to 2
Var — p = (1, 2)
Var — pick = ref (p.Left > 0 ? ref values[0] : ref values[1])
Var — buffer = stackalloc[] { (byte)1, (byte)2 }
Var — twice = &Twice
Var — group = Twice
Var — attributed = [Obsolete] (int x) => x
Var — loose = 3
Var — maybe = default
Var — defaulted = default
Return — return twice(pick) + group(buffer.Length) + loose + defaulted
== Syntax.Advanced.Advanced.Twice(int)
