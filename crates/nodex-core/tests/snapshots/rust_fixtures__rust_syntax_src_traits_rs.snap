== crate::traits::Container::first
Entry — when first() is called
Return — return self.get(0)
== crate::traits::Stack::get
Entry — when get(index) is called
Return — return self.items.get(index)
== crate::traits::Stack::map_all
Entry — when map_all(f) is called
Return — return self.items → iter() → map(f) → collect()
== crate::traits::Stack::new
Entry — when new() is called
Return — return Stack { items: Vec::new() }
== crate::traits::Stack::push
Entry — when push(item) is called
Call — self.items.push(item)
Return — return self
== crate::traits::Stack::fmt
EventEntry — when a Stack is formatted as text ({} in println!, format!, to_string)
Loop.ForEach — for each item in &self.items
  body:
    Call — write!(f, "{item} ")?
      error:
Return — return Ok(())
