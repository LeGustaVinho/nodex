{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodex",
  "mainBinaryName": "Nodex",
  "identifier": "io.github.legustavinho.nodex",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Read code in any language as node graphs",
    "longDescription": "Nodex turns C#, Unity, TypeScript/JavaScript and Rust projects into language-agnostic, Blueprint-style node graphs, UML diagrams and live execution traces.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QTQwN0RBMzUyOUIyRDMKUldUVHNpazEyZ2VrdFVnVjRoU3RLUXNIWmZKcnZESG8zMm5TdVk5QUxmeE13Tm1MRlJuMDRTOEwK",
      "endpoints": [
        "https://github.com/LeGustaVinho/nodex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
