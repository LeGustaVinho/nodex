<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <!-- The weaving itself is shared with the Unity package's IL post-processor. -->
  <ItemGroup>
    <Compile Include="..\..\unity\com.nodex.trace\CodeGen\ModuleWeaver.cs" Link="Shared\ModuleWeaver.cs" />
    <Compile Include="..\..\unity\com.nodex.trace\CodeGen\SourceMaps.cs" Link="Shared\SourceMaps.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nodex.Trace\Nodex.Trace.csproj" />
  </ItemGroup>

</Project>
